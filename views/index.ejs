<%- include('partials/header', { pageTitle: 'Home', activePage: 'home' }) %>

<div class="container py-5">
    <!-- Hero Section -->
    <div class="hero-section text-center mb-5">
        <h1 class="display-3 fw-bold hero-title mb-3">
            Welcome to My Blog
        </h1>
        <p class="lead text-muted mb-4">Share your thoughts, ideas, and stories with the world</p>
        <a href="/posts/new" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Create New Post
        </a>
    </div>

    <!-- Blog Posts Grid -->
    <% if (posts && posts.length > 0) { %>
        <div class="row g-4 mb-5">
            <% posts.forEach((post, index) => { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card blog-card h-100 shadow-sm hover-lift">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-primary">Post #<%= post.id %></span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    <%= new Date(post.date).toLocaleDateString('en-US', { 
                                        year: 'numeric', 
                                        month: 'short', 
                                        day: 'numeric' 
                                    }) %>
                                </small>
                            </div>
                            
                            <h3 class="card-title h5 mb-3">
                                <a href="/posts/<%= post.id %>" class="text-decoration-none text-dark stretched-link">
                                    <%= post.title %>
                                </a>
                            </h3>
                            
                            <p class="card-text text-muted mb-3 flex-grow-1">
                                <%= post.content.length > 120 ? post.content.substring(0, 120) + '...' : post.content %>
                            </p>
                            
                            <div class="card-footer-meta mt-auto pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="bi bi-person-circle me-1"></i>
                                        <%= post.author %>
                                    </small>
                                    <span class="read-more text-primary">
                                        Read more <i class="bi bi-arrow-right ms-1"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state text-center py-5">
            <div class="empty-icon mb-4">
                <i class="bi bi-journal-x display-1 text-muted"></i>
            </div>
            <h3 class="mb-3">No posts yet</h3>
            <p class="text-muted mb-4">Start sharing your thoughts by creating your first blog post!</p>
            <a href="/posts/new" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-2"></i>Create Your First Post
            </a>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
